{
    "version": 2,
    "builds":[
        {
            "src":"*.js",
            "use":"@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest":"index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/weekly-analytics",
            "schedule": "0 0 * * 0"
        }
    ]
}