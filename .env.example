# ---- Core ----
MONGO_URI=
JWT_SECRET=
PORT=5000
CLIENT_URL=https://campuscrave.com.ng
# Optional comma-separated extra origins for CORS
CORS_ORIGINS=

# ---- Scheduled / cron endpoints ----
# Required. /api/cron/* returns 503 until this is set.
CRON_SECRET=

# ---- Payments (Paystack) ----
PAYSTACK_SECRET_KEY=
# Optional overrides; defaults already match the checkout UI (whole Naira).
PLAN_PRICE_PREMIUM=1500
PLAN_PRICE_PREMIUM6M=7000

# ---- Email (Brevo transactional API) ----
BREVO_API_KEY=
SMTP_FROM="CampusCrave <no-reply@campuscrave.ng>"

# ---- Uploads (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_IMAGE_BYTES=8388608

# ---- Google Sign-In ----
GOOGLE_CLIENT_ID=

# ---- Jobs feed ----
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# ---- Operations ----
PLATFORM_SUPPORT_EMAIL=
BULK_EMAIL_DAILY_LIMIT=60
ALLOW_ALL_STORES=true
# Set to true only in local development to bypass rate limits.
DISABLE_RATE_LIMIT=false
# Salt for hashed IPs (falls back to JWT_SECRET when omitted).
IP_HASH_SALT=

# ---- Partner Shopping (Jumia / Temu) ----
# All optional. Partner mode is stored in MongoDB and defaults to DISABLED.
# Extra approved hostnames for partner links, comma-separated.
PARTNER_ALLOWED_HOSTS_JUMIA=
PARTNER_ALLOWED_HOSTS_TEMU=
# Webhook secrets. Until these are set, partner webhooks fail closed (503).
# Only configure once the partner has issued the secret.
JUMIA_WEBHOOK_SECRET=
TEMU_WEBHOOK_SECRET=
